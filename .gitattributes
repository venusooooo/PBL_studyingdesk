# 统一换行规则，避免 Windows 的 core.autocrlf 把源码改回 CRLF
* text=auto

# 源码与配置：强制 LF
*.java          text eol=lf
*.md            text eol=lf
*.xml           text eol=lf
*.iml           text eol=lf
*.gitignore     text eol=lf
*.gitattributes text eol=lf
.editorconfig   text eol=lf

# Windows 批处理：必须 CRLF，否则 cmd.exe 解析异常
*.bat           text eol=crlf
*.cmd           text eol=crlf

# 二进制文件不做换行转换
*.jar           binary
*.png           binary
*.jpg           binary
*.exe           binary
*.dll           binary
*.class         binary
